# SENTRY Environment Configuration
PROJECT_NAME="SENTRY - Forensic Email Threat Intelligence Platform"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL)
POSTGRES_DB=sentry_db
POSTGRES_USER=sentry
POSTGRES_PASSWORD=sentry_secret_2025
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=sqlite+aiosqlite:///./sentry.db
SYNC_DATABASE_URL=sqlite:///./sentry.db

# Cache & Message Broker (Redis)
REDIS_URL=redis://localhost:6379/0

# Graph Intelligence Database (Neo4j)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sentry_graph_2025

# Security & JWT
SECRET_KEY=sentry_super_secret_jwt_key_hackathon_2025_entropy_high
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Evidence Store (RFC 3227 Immutable Vault)
EVIDENCE_VAULT_DIR=./evidence_vault

# Threat Intelligence API Keys (Optional with fallbacks)
VIRUSTOTAL_API_KEY=""
URLHAUS_API_KEY=""
THREATFOX_API_KEY=""
IPINFO_TOKEN=""

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/v1/dashboard/live
