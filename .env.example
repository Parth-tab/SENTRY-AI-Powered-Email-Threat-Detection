# SENTRY Environment Configuration
# Default: Standalone Air-Gapped Appliance Mode (Zero external dependencies)

PROJECT_NAME=SENTRY
VERSION=1.0.0
API_V1_STR=/api/v1
SECRET_KEY=sentry_demo_secret_key_2025_evidentiary_standard
ADMIN_TOKEN=sentry_admin_demo_secret_2025

# Database Storage: SQLite (aiosqlite) by default; Postgres in production container mode
DATABASE_URL=sqlite+aiosqlite:///./sentry.db
SYNC_DATABASE_URL=sqlite:///./sentry.db

# Evidence Storage Directory
EVIDENCE_VAULT_DIR=./evidence_vault

# Optional Enterprise Distributed Services (Leave commented for standalone appliance mode)
# REDIS_URL=redis://localhost:6379/0
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=sentry_graph_2025
