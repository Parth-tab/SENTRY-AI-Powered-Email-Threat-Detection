# SENTRY Environment Configuration Template
# Copy this file to .env and inject cryptographically secure tokens in production.

ENVIRONMENT=demo
BUILD_MODE=demo
SERVE_STATIC=false

# Security Credentials (LAW 0: Generate high-entropy random secrets for production)
SECRET_KEY=sentry_demo_secret_key_2025_evidentiary_standard
ADMIN_TOKEN=sentry_admin_demo_secret_2025
SENTRY_API_TOKEN=sentry_operator_token_2025

# Storage Paths
DATABASE_URL=sqlite+aiosqlite:///backend/sentry.db
SYNC_DATABASE_URL=sqlite:///backend/sentry.db
EVIDENCE_VAULT_DIR=./evidence_vault
LOGS_DIR=./logs

# Optional CORS Extra Origins (comma-separated)
CORS_ORIGINS=
